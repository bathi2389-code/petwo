{
  "name": "PETWO Full-Stack Cloud Environment",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:1-20-bullseye",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers-contrib/features/flutter:2": {}
  },
  "forwardPorts": [3000, 3001, 4000],
  "portsAttributes": {
    "3000": {
      "label": "Provider Web Portal",
      "onAutoForward": "openBrowser"
    },
    "3001": {
      "label": "Admin Web Console",
      "onAutoForward": "notify"
    },
    "4000": {
      "label": "Fastify API & Swagger Docs",
      "onAutoForward": "notify"
    }
  },
  "postCreateCommand": "npm install && npm run build --workspace=@petwo/shared",
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "Dart-Code.flutter",
        "Dart-Code.dart-code",
        "esbenp.prettier-vscode"
      ]
    }
  }
}
