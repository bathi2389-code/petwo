# PETWO Backend Environment Configuration
# Copy this to .env and fill in real values — NEVER commit .env

# ─── Server ─────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
API_VERSION=v1
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# ─── Firebase ───────────────────────────────────────────────────────────────
FIREBASE_PROJECT_ID=petwo-95436
FIREBASE_PRIVATE_KEY_ID=your-private-key-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n<service-account-private-key>\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@petwo-95436.iam.gserviceaccount.com
FIREBASE_CLIENT_ID=your-client-id
FIREBASE_STORAGE_BUCKET=your-project-storage-bucket

# ─── JWT ────────────────────────────────────────────────────────────────────
JWT_SECRET=your-jwt-secret-at-least-32-chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# ─── Payments (Disabled for MVP) ────────────────────────────────────────────
# Set PAYMENTS_ENABLED=true and provide Razorpay credentials when ready to activate online payments.
# Disabled by default when credentials are absent or PAYMENTS_ENABLED=false.
PAYMENTS_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ─── Optional integrations ──────────────────────────────────────────────────
GEMINI_API_KEY=
WHATSAPP_API_KEY=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# ─── Algolia ────────────────────────────────────────────────────────────────
ALGOLIA_APP_ID=your-algolia-app-id
ALGOLIA_ADMIN_API_KEY=your-algolia-admin-key
ALGOLIA_INDEX_PROVIDERS=petwo_providers_dev

# ─── Google Maps ────────────────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=your-google-maps-server-key

# ─── Rate Limiting ──────────────────────────────────────────────────────────
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000

# ─── Logging ────────────────────────────────────────────────────────────────
LOG_LEVEL=debug
