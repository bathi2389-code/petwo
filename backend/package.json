{
  "name": "@petwo/backend",
  "version": "1.0.0",
  "description": "PETWO Backend API — Node.js + TypeScript + Fastify",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "ESLINT_USE_FLAT_CONFIG=false eslint src --ext .ts",
    "type-check": "tsc --noEmit",
    "db:seed": "tsx scripts/seed.ts"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.0",
    "@fastify/helmet": "^11.0.0",
    "@fastify/jwt": "^8.0.0",
    "@fastify/rate-limit": "^9.0.0",
    "@fastify/swagger": "^8.0.0",
    "@fastify/swagger-ui": "^3.0.0",
    "@petwo/shared": "*",
    "fastify": "^4.27.0",
    "firebase-admin": "^12.0.0",
    "zod": "^3.23.0",
    "zod-to-json-schema": "^3.23.0",
    "razorpay": "^2.9.0",
    "axios": "^1.7.0",
    "dayjs": "^1.11.0",
    "nanoid": "^3.3.7",
    "pino": "^9.0.0",
    "pino-pretty": "^11.0.0",
    "dotenv": "^16.4.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.16.0",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0",
    "@vitest/coverage-v8": "^1.6.0",
    "eslint": "^8.57.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0"
  }
}
